# Example only. Do not commit real secrets.
# Configure real values in local env and hosting environment settings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Platform admin auth (Auth.js / NextAuth credentials bootstrap)
AUTH_SECRET="replace-with-long-random-secret"
NEXTAUTH_SECRET="replace-with-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
PLATFORM_ADMIN_ACCESS_CODE="replace-with-temporary-admin-access-code"

# Comma-separated platform admin allowlist.
PLATFORM_ADMIN_EMAILS="admin@example.com,owner@example.com"

# Transactional email provider (Resend)
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="MyExperiment.club <noreply@myexperiment.club>"
PLATFORM_NOTIFICATION_EMAIL="ops@myexperiment.club"
RESEND_WEBHOOK_SECRET="rewhsec_replace_me"

# Stripe checkout and billing (MyExperiment.club subscription purchases)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PRICE_MONTHLY_SUBSCRIPTION="price_replace_monthly"
STRIPE_PRICE_SETUP_FEE="price_replace_setup"
STRIPE_PRICE_DOMAIN_SERVICE="price_replace_domain"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STRIPE_PLATFORM_TEST_PRODUCT_ID="prod_replace_platform_test_product"
STRIPE_PLATFORM_TEST_PRICE_ID="price_replace_platform_test_price"

# Stripe Account Links for subscriber businesses taking their own customer booking payments.
# Uses platform STRIPE_SECRET_KEY to create connected accounts; do not collect business-owner secret keys.
STRIPE_TENANT_WEBHOOK_SECRET="whsec_replace_tenant_booking_webhook"
