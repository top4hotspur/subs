generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model TenantSite {
  id                        String                 @id @default(cuid())
  slug                      String                 @unique
  displayName               String
  industrySlug              String?
  status                    String
  domainPrimary             String?
  setupRequestId            String?                @unique
  provisioningStatus        String?
  subscriptionStatus        String?
  domainStatus              String?
  whatsappAddonEnabled      Boolean                @default(false)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  setupRequests             SetupRequest[]         @relation("TenantSiteSetupRequests")
  demoDraftSnapshots        DemoDraftSnapshot[]
  siteDomains               SiteDomain[]
  provisioningTasks         SiteProvisioningTask[]
  statusEvents              SiteStatusEvent[]
  subscriptions             SubscriptionRecord[]
  setupRequest              SetupRequest?          @relation("SetupRequestToTenantSite", fields: [setupRequestId], references: [id])
}

model DemoDraftSnapshot {
  id                 String       @id @default(cuid())
  tenantSiteId       String?
  setupRequestId     String?      @unique
  templateSlug       String
  draftName          String?
  draftJson          Json
  source             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  tenantSite         TenantSite?  @relation(fields: [tenantSiteId], references: [id])
  setupRequest       SetupRequest?

  @@index([tenantSiteId])
}

model SetupRequest {
  id                  String             @id @default(cuid())
  tenantSiteId        String?
  demoDraftSnapshotId String?            @unique
  industrySlug        String
  businessName        String
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  domainOption        String
  existingDomain      String?
  desiredDomain       String?
  communicationOption String
  setupTotalGbp       Int
  monthlyTotalGbp     Int
  status              String
  notes               String?
  rawPayload          Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenantSite          TenantSite?        @relation("TenantSiteSetupRequests", fields: [tenantSiteId], references: [id])
  demoDraftSnapshot   DemoDraftSnapshot? @relation(fields: [demoDraftSnapshotId], references: [id])
  events              SetupRequestEvent[]
  siteTenant          TenantSite?        @relation("SetupRequestToTenantSite")
  provisioningTasks   SiteProvisioningTask[]

  @@index([industrySlug])
  @@index([status])
  @@index([createdAt])
  @@index([tenantSiteId])
}

model SetupRequestEvent {
  id             String       @id @default(cuid())
  setupRequestId String
  eventType      String
  message        String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  setupRequest   SetupRequest @relation(fields: [setupRequestId], references: [id], onDelete: Cascade)

  @@index([setupRequestId])
}

model PlatformAdminUser {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteDomain {
  id             String     @id @default(cuid())
  tenantSiteId   String
  domain         String
  domainType     String
  status         String
  registrarNotes String?
  dnsInstructions Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenantSite     TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([domain])
  @@unique([tenantSiteId, domain, domainType])
}

model SiteProvisioningTask {
  id             String       @id @default(cuid())
  tenantSiteId   String
  setupRequestId String?
  taskType       String
  status         String
  title          String
  notes          String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenantSite     TenantSite   @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  setupRequest   SetupRequest? @relation(fields: [setupRequestId], references: [id], onDelete: SetNull)

  @@index([tenantSiteId])
  @@index([setupRequestId])
  @@index([status])
}

model SiteStatusEvent {
  id           String     @id @default(cuid())
  tenantSiteId String
  eventType    String
  message      String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  tenantSite   TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([createdAt])
}

model SubscriptionRecord {
  id                  String     @id @default(cuid())
  tenantSiteId        String
  status              String
  setupFeeGbp         Int
  monthlyFeeGbp       Int
  domainFeeGbp        Int
  whatsappAddonEnabled Boolean   @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenantSite          TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
}

model SalesLead {
  id              String           @id @default(cuid())
  businessName    String
  location        String?
  industrySlug    String?
  industryLabel   String?
  contactName     String?
  email           String?
  phone           String?
  status          String
  source          String?
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          SalesLeadEvent[]

  @@index([status])
  @@index([industrySlug])
  @@index([businessName])
  @@index([location])
  @@index([createdAt])
}

model SalesLeadEvent {
  id          String    @id @default(cuid())
  salesLeadId String
  eventType   String
  message     String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  @@index([salesLeadId])
  @@index([createdAt])
}
