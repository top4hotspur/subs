generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model TenantSite {
  id                        String                 @id @default(cuid())
  slug                      String                 @unique
  displayName               String
  industrySlug              String?
  status                    String
  domainPrimary             String?
  setupRequestId            String?                @unique
  provisioningStatus        String?
  subscriptionStatus        String?
  domainStatus              String?
  whatsappAddonEnabled      Boolean                @default(false)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  setupRequests             SetupRequest[]         @relation("TenantSiteSetupRequests")
  demoDraftSnapshots        DemoDraftSnapshot[]
  siteDomains               SiteDomain[]
  provisioningTasks         SiteProvisioningTask[]
  statusEvents              SiteStatusEvent[]
  subscriptions             SubscriptionRecord[]
  customerSiteSettings      CustomerSiteSettings?
  customerSiteServiceCategories CustomerSiteServiceCategory[]
  customerSiteServices      CustomerSiteService[]
  customerSiteStaffRoles    CustomerSiteStaffRole[]
  customerSiteStaffMembers  CustomerSiteStaffMember[]
  customerSiteStaffRotaDays CustomerSiteStaffRotaDay[]
  customerSiteStaffBreakWindows CustomerSiteStaffBreakWindow[]
  customerSiteBusinessClosures CustomerSiteBusinessClosure[]
  customerSiteStaffHolidays CustomerSiteStaffHoliday[]
  customerSiteBookings      CustomerSiteBooking[]
  customerSiteAdminUsers    CustomerSiteAdminUser[]
  setupRequest              SetupRequest?          @relation("SetupRequestToTenantSite", fields: [setupRequestId], references: [id])
}

model DemoDraftSnapshot {
  id                 String       @id @default(cuid())
  tenantSiteId       String?
  setupRequestId     String?      @unique
  templateSlug       String
  draftName          String?
  draftJson          Json
  source             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  tenantSite         TenantSite?  @relation(fields: [tenantSiteId], references: [id])
  setupRequest       SetupRequest?

  @@index([tenantSiteId])
}

model SetupRequest {
  id                  String             @id @default(cuid())
  tenantSiteId        String?
  demoDraftSnapshotId String?            @unique
  confirmationTokenHash String?
  confirmationTokenCreatedAt DateTime?
  confirmationTokenLastUsedAt DateTime?
  confirmationAccessCount Int            @default(0)
  industrySlug        String
  businessName        String
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  domainOption        String
  existingDomain      String?
  desiredDomain       String?
  communicationOption String
  setupTotalGbp       Int
  monthlyTotalGbp     Int
  status              String
  paymentStatus       String?
  paymentProvider     String?
  stripeCheckoutSessionId String?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  paymentStartedAt    DateTime?
  paymentCompletedAt  DateTime?
  archivedAt          DateTime?
  notes               String?
  rawPayload          Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenantSite          TenantSite?        @relation("TenantSiteSetupRequests", fields: [tenantSiteId], references: [id])
  demoDraftSnapshot   DemoDraftSnapshot? @relation(fields: [demoDraftSnapshotId], references: [id])
  events              SetupRequestEvent[]
  siteTenant          TenantSite?        @relation("SetupRequestToTenantSite")
  provisioningTasks   SiteProvisioningTask[]

  @@index([industrySlug])
  @@index([status])
  @@index([createdAt])
  @@index([tenantSiteId])
  @@index([paymentStatus])
  @@index([archivedAt])
  @@index([stripeCheckoutSessionId])
  @@index([stripeSubscriptionId])
}

model SetupRequestEvent {
  id             String       @id @default(cuid())
  setupRequestId String
  eventType      String
  message        String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  setupRequest   SetupRequest @relation(fields: [setupRequestId], references: [id], onDelete: Cascade)

  @@index([setupRequestId])
}

model PlatformAdminUser {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteDomain {
  id             String     @id @default(cuid())
  tenantSiteId   String
  domain         String
  domainType     String
  status         String
  registrarNotes String?
  dnsInstructions Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenantSite     TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([domain])
  @@unique([tenantSiteId, domain, domainType])
}

model SiteProvisioningTask {
  id             String       @id @default(cuid())
  tenantSiteId   String
  setupRequestId String?
  taskType       String
  status         String
  title          String
  notes          String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenantSite     TenantSite   @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  setupRequest   SetupRequest? @relation(fields: [setupRequestId], references: [id], onDelete: SetNull)

  @@index([tenantSiteId])
  @@index([setupRequestId])
  @@index([status])
}

model SiteStatusEvent {
  id           String     @id @default(cuid())
  tenantSiteId String
  eventType    String
  message      String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  tenantSite   TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([createdAt])
}

model SubscriptionRecord {
  id                  String     @id @default(cuid())
  tenantSiteId        String
  status              String
  setupFeeGbp         Int
  monthlyFeeGbp       Int
  domainFeeGbp        Int
  whatsappAddonEnabled Boolean   @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenantSite          TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
}

model SalesLead {
  id              String           @id @default(cuid())
  businessName    String
  location        String?
  country         String?
  cityTown        String?
  postcode        String?
  address         String?
  serviceArea     String?
  industrySlug    String?
  industryLabel   String?
  contactName     String?
  contactFirstName String?
  contactLastName String?
  email           String?
  phone           String?
  leadSource      String?
  sourceUrl       String?
  currentProvider String?
  estimatedCurrentMonthlyCost Decimal? @db.Decimal(10, 2)
  marketingStatus String        @default("ACTIVE")
  unsubscribedAt  DateTime?
  doNotContactReason String?
  status          String
  source          String?
  notes           String?
  lastContactedAt DateTime?
  lastMarketingEmailAt DateTime?
  emailSentCount  Int              @default(0)
  nextFollowUpAt  DateTime?
  lastCampaignStep String?
  snoozedUntil    DateTime?
  convertedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          SalesLeadEvent[]
  campaignRecipients SalesCampaignRecipient[]
  campaignEvents  SalesCampaignEvent[]

  @@index([status])
  @@index([industrySlug])
  @@index([contactFirstName])
  @@index([contactLastName])
  @@index([businessName])
  @@index([location])
  @@index([country])
  @@index([cityTown])
  @@index([createdAt])
  @@index([postcode])
  @@index([serviceArea])
  @@index([marketingStatus])
  @@index([lastCampaignStep])
  @@index([snoozedUntil])
}

model SalesLeadEvent {
  id          String    @id @default(cuid())
  salesLeadId String
  eventType   String
  message     String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  salesLead   SalesLead @relation(fields: [salesLeadId], references: [id], onDelete: Cascade)

  @@index([salesLeadId])
  @@index([createdAt])
}

model SalesCampaign {
  id            String                  @id @default(cuid())
  name          String
  industrySlug  String?
  serviceArea   String?
  campaignLevel String
  status        String                  @default("DRAFT")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  recipients    SalesCampaignRecipient[]
  events        SalesCampaignEvent[]

  @@index([industrySlug])
  @@index([serviceArea])
  @@index([campaignLevel])
  @@index([status])
}

model SalesCampaignTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique
  channel     String
  subject     String?
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channel])
}

model SalesProviderPricing {
  id                 String   @id @default(cuid())
  providerKey        String   @unique
  providerName       String
  estimatedMonthlyGbp Decimal? @db.Decimal(10, 2)
  notes              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active])
}

model SalesCampaignRecipient {
  id         String        @id @default(cuid())
  campaignId String
  leadId     String
  status     String        @default("QUEUED")
  sentAt     DateTime?
  clickedAt  DateTime?
  lastEventAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  campaign   SalesCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       SalesLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
}

model SalesCampaignEvent {
  id            String        @id @default(cuid())
  campaignId    String?
  leadId        String?
  resendEmailId String?
  eventType     String
  eventId       String?       @unique
  clickedUrl    String?
  raw           Json?
  createdAt     DateTime      @default(now())
  campaign      SalesCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead          SalesLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([leadId])
  @@index([eventType])
  @@index([createdAt])
}

model CustomerSiteSettings {
  id                  String     @id @default(cuid())
  tenantSiteId        String     @unique
  siteDisplayName     String?
  businessName        String?
  phone               String?
  email               String?
  address             String?
  openingHoursSummary String?
  openingHoursJson    Json?
  heroHeadline        String?
  heroSubheading      String?
  visualThemeId       String?
  colourPaletteId     String?
  currency            String?    @default("GBP")
  logoUrl             String?
  logoStorageKey      String?
  logoContentType     String?
  logoFileName        String?
  faviconUrl          String?
  faviconStorageKey   String?
  faviconContentType  String?
  faviconFileName     String?
  paymentProcessorSetupMode String?
  paymentProcessorName String?
  paymentProcessorAccountRef String?
  paymentProcessorNotes String?
  acceptCashPayments   Boolean   @default(false)
  acceptCardPayments   Boolean   @default(true)
  requireBookingPrepayment Boolean @default(false)
  allowInStorePaymentRecording Boolean @default(false)
  cancellationFullRefundNoticeDays Int? @default(1)
  cancellationNoRefundWithinDays Int? @default(1)
  cancellationPolicyNote String?
  aboutPageEnabled      Boolean   @default(false)
  policyPageEnabled     Boolean   @default(true)
  aboutPageMode         String?
  aboutTitle            String?
  aboutBody             String?
  aboutImageOneUrl      String?
  aboutImageTwoUrl      String?
  aboutImagePlacement   String?
  aboutStaffProfilesJson Json?
  contactTitle          String?
  contactIntro          String?
  contactMapEnabled     Boolean   @default(true)
  contactMapNote        String?
  policyTitle           String?
  policyIntro           String?
  policyBody            String?
  policyDefaultAccepted Boolean   @default(false)
  socialLinks           Json?
  recurringPaymentsEnabled Boolean @default(false)
  customerBlockBookingsEnabled Boolean @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenantSite          TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
}

model CustomerSiteService {
  id                 String     @id @default(cuid())
  tenantSiteId       String
  categoryId         String?
  name               String
  description        String?
  basePrice          Decimal?   @db.Decimal(10, 2)
  durationMinutes    Int?
  bufferAfterMinutes Int?
  active             Boolean    @default(true)
  sortOrder          Int        @default(0)
  rolePriceOverrides Json?
  recurringEnabled   Boolean    @default(false)
  recurringIntervals Json?
  blockBookingEnabled Boolean   @default(false)
  blockBookingSuggestedCounts Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  tenantSite         TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  category           CustomerSiteServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantSiteId])
  @@index([categoryId])
  @@index([active])
  @@index([sortOrder])
}

model CustomerSiteServiceCategory {
  id           String                @id @default(cuid())
  tenantSiteId String
  name         String
  sortOrder    Int                   @default(0)
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenantSite   TenantSite            @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  services     CustomerSiteService[]

  @@index([tenantSiteId])
  @@index([tenantSiteId, active])
  @@index([tenantSiteId, sortOrder])
}

model CustomerSiteStaffRole {
  id           String     @id @default(cuid())
  tenantSiteId String
  label        String
  platformRole String?
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenantSite   TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  staffMembers CustomerSiteStaffMember[]

  @@index([tenantSiteId])
  @@index([tenantSiteId, active])
  @@index([tenantSiteId, sortOrder])
}

model CustomerSiteStaffMember {
  id                String                 @id @default(cuid())
  tenantSiteId      String
  roleId            String?
  displayName       String
  roleLabel         String?
  email             String?
  phone             String?
  bio               String?
  active            Boolean                @default(true)
  customerSelectable Boolean               @default(false)
  isSuperUser       Boolean                @default(false)
  availableWeekdays Json?
  serviceIds        Json?
  notes             String?
  sortOrder         Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenantSite        TenantSite             @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  role              CustomerSiteStaffRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  rotaDays          CustomerSiteStaffRotaDay[]
  breakWindows      CustomerSiteStaffBreakWindow[]
  holidays          CustomerSiteStaffHoliday[]

  @@index([tenantSiteId])
  @@index([tenantSiteId, active])
  @@index([tenantSiteId, sortOrder])
  @@index([roleId])
}

model CustomerSiteStaffRotaDay {
  id            String                  @id @default(cuid())
  tenantSiteId  String
  staffMemberId String
  weekday       String
  working       Boolean                 @default(false)
  startTime     String?
  endTime       String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  tenantSite    TenantSite              @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  staffMember   CustomerSiteStaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  breakWindows  CustomerSiteStaffBreakWindow[]

  @@index([tenantSiteId])
  @@index([staffMemberId])
  @@index([tenantSiteId, staffMemberId, weekday])
}

model CustomerSiteStaffBreakWindow {
  id            String                  @id @default(cuid())
  tenantSiteId  String
  staffMemberId String
  rotaDayId     String?
  weekday       String
  label         String?
  startTime     String
  endTime       String
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  tenantSite    TenantSite              @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  staffMember   CustomerSiteStaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  rotaDay       CustomerSiteStaffRotaDay? @relation(fields: [rotaDayId], references: [id], onDelete: SetNull)

  @@index([tenantSiteId])
  @@index([staffMemberId])
  @@index([rotaDayId])
  @@index([tenantSiteId, staffMemberId, weekday])
}

model CustomerSiteBusinessClosure {
  id           String    @id @default(cuid())
  tenantSiteId String
  date         String
  endDate      String?
  label        String
  allDay       Boolean   @default(true)
  startTime    String?
  endTime      String?
  active       Boolean   @default(true)
  customerNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenantSite   TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([tenantSiteId, date])
  @@index([tenantSiteId, active])
}

model CustomerSiteStaffHoliday {
  id            String                  @id @default(cuid())
  tenantSiteId  String
  staffMemberId String
  date          String
  endDate       String?
  label         String
  allDay        Boolean                 @default(true)
  startTime     String?
  endTime       String?
  active        Boolean                 @default(true)
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  tenantSite    TenantSite              @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)
  staffMember   CustomerSiteStaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([staffMemberId])
  @@index([tenantSiteId, date])
  @@index([tenantSiteId, staffMemberId, date])
  @@index([tenantSiteId, active])
}

model CustomerSiteBooking {
  id            String    @id @default(cuid())
  tenantSiteId  String
  serviceId     String?
  serviceName   String?
  customerName  String
  customerEmail String?
  customerPhone String?
  preferredDate String?
  preferredTime String?
  startDateTime DateTime?
  endDateTime   DateTime?
  staffMemberId String?
  staffName     String?
  status        String
  paymentStatus String?
  paymentMethod String?
  paymentAmountPence Int?
  paymentCurrency String?
  paymentProvider String?
  paymentProviderSessionId String?
  paymentProviderPaymentIntentId String?
  notes         String?
  policyAcceptedAt DateTime?
  source        String?
  rawPayload    Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantSite    TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([tenantSiteId, preferredDate])
  @@index([tenantSiteId, status])
  @@index([tenantSiteId, staffMemberId])
  @@index([tenantSiteId, serviceId])
  @@index([paymentProviderSessionId])
  @@index([paymentProviderPaymentIntentId])
}

model CustomerSiteAdminUser {
  id               String    @id @default(cuid())
  tenantSiteId     String
  email            String
  displayName      String?
  role             String
  active           Boolean   @default(true)
  invitationStatus String
  accessCodeHash   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenantSite       TenantSite @relation(fields: [tenantSiteId], references: [id], onDelete: Cascade)

  @@index([tenantSiteId])
  @@index([email])
  @@index([tenantSiteId, active])
  @@unique([tenantSiteId, email])
}

model ContactEnquiry {
  id           String   @id @default(cuid())
  name         String
  businessName String?
  email        String
  phone        String?
  industrySlug String?
  message      String
  source       String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([industrySlug])
}
